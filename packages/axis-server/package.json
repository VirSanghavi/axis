{
  "name": "@virsanghavi/axis-server",
  "version": "1.14.1",
  "description": "One coordination board for a team's coding agents. Claude Code, Cursor, Codex and Windsurf share a job board and take a lock on a file before editing it, so agents run by different people do not overwrite each other.",
  "mcpName": "dev.useaxis/axis",
  "license": "AGPL-3.0-only",
  "author": "Vir Sanghavi",
  "homepage": "https://useaxis.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VirSanghavi/axis.git",
    "directory": "packages/axis-server"
  },
  "bugs": {
    "url": "https://github.com/VirSanghavi/axis/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-code",
    "cursor",
    "coding-agent",
    "agent-orchestration",
    "multi-agent",
    "file-locking",
    "ai-agents"
  ],
  "main": "dist/index.js",
  "bin": {
    "axis-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "start": "node dist/cli.js",
    "build": "tsup bin/index.ts bin/cli.ts --format cjs --out-dir dist --clean --shims && tsup ../../src/local/mcp-server.ts --format esm --out-dir dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "chalk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.39.0",
    "async-mutex": "^0.5.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "openai": "^4.24.0",
    "zod": "^3.22.4",
    "execa": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.4",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
