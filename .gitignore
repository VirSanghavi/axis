# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Axis runtime state (auto-generated when the server runs; never commit)
# Keep .axis/axis.json (project config) trackable, ignore generated artifacts.
.axis-server.log
**/.axis-server.log
.axis/instructions/
**/.axis/instructions/
# Session archives, nerve-center state, and tool logs are runtime artifacts.
history/

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
*.map
next-env.d.ts

# Package build artifacts (never commit; every publish rebuilds from source)
#   npm:    `npm run build` in packages/axis-server and packages/axis-init
#   python: `python -m build` in packages/python-sdk
packages/*/dist/
packages/*/build/
packages/*/*.egg-info/
packages/**/*.whl
packages/**/*.tar.gz
# Local virtualenv for the python SDK
packages/*/venv/

# backend — supabase: ignore CLI runtime dirs (.temp/.branches) but track ALL
# migrations by pattern, so a new migration is never silently invisible to git.
# (Per-file allowlisting burned us: migrate.yml auto-applies on main, and an
# unlisted migration could never reach it.)
/supabase
!/supabase/
/supabase/*
!/supabase/migrations/
!/supabase/README.md
!/supabase/config.toml
!/supabase/schema.sql
/supabase/migrations/*
!/supabase/migrations/*.sql
/sandbox_mcp_test
/sandbox
packages/python-sdk/axis/__pycache__/
sandbox/
**/__pycache__/

# Frontend moved to private repo VirSanghavi/axis-frontend — never re-track here
frontend/

# Local tooling artifacts (screenshots, browser traces)
.playwright-mcp/
before-hero.png
